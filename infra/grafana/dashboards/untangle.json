        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(increase(ticket_creations_total[24h]))",
          "legendFormat": "tickets"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
