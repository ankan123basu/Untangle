# =============================================================================
# Untangle environment variables
# -----------------------------------------------------------------------------
# Copy to .env (`make up` does this for you on a fresh clone) and change values.
# .env is git-ignored. NEVER commit real secrets.
# Variables marked "(Phase N)" are not read yet; they are listed now so the
# full configuration surface is visible from day one.
# =============================================================================

# ---- Ports published on your machine ----------------------------------------
# Postgres in Docker. 5433 avoids clashing with a local Postgres on 5432.
POSTGRES_HOST_PORT=5433
BACKEND_HOST_PORT=8080
# The app in Docker: open http://localhost:3000
FRONTEND_HOST_PORT=3000
REDIS_HOST_PORT=6379

# ---- Database ---------------------------------------------------------------
POSTGRES_DB=untangle
POSTGRES_USER=untangle
# Local-only default. Use a long random value anywhere else.
POSTGRES_PASSWORD=untangle-local-dev-only

# ---- Backend ----------------------------------------------------------------
# Spring profiles inside Docker.
#   prod       secure defaults (always include it in Docker)
#   demo       loads demo data: 9 staff, 1 partner, 60 tickets. Password for every demo
#              account: Untangle@2026. Remove `demo` for an empty database.
#              NEVER use `demo` in a real production environment.
SPRING_PROFILES_ACTIVE=prod,demo

# Hikari connection pool size (per backend instance).
# DB_POOL_MAX_SIZE=10

# REQUIRED. HMAC-SHA256 key that signs access tokens: base64, at least 32 bytes.
# Left empty here on purpose: `make up` (via `make .env`) fills it with `openssl rand -base64 48`.
# The backend refuses to start if it is missing or too short. Rotating it signs everyone out.
JWT_SECRET=

# First admin, created on startup only if NO active admin exists (A12). Not needed with the demo
# profile, which already contains admin@untangle.local. Password: at least 10 characters.
# BOOTSTRAP_ADMIN_EMAIL=admin@yourcompany.example
# BOOTSTRAP_ADMIN_PASSWORD=
# BOOTSTRAP_ADMIN_NAME=Administrator

# Refresh-token cookie `Secure` flag. Keep true (localhost counts as secure in Chrome/Firefox).
# Set false only for plain-HTTP access from Safari or another machine.
# AUTH_COOKIE_SECURE=true

# Allowed browser origins for CORS, comma-separated. Only needed if the SPA is served from a
# different origin than the API (nginx in Docker and Vite in dev both proxy /api, so normally unset).
# CORS_ALLOWED_ORIGINS=https://app.example.com

# REQUIRED. AES-256-GCM master key that encrypts partner HMAC secrets at rest: base64, exactly
# 32 bytes. Left empty on purpose: `make .env` fills it with `openssl rand -base64 32`.
# The backend refuses to start without it. If you lose it, rotate every partner secret.
APP_SECRET_ENCRYPTION_KEY=

# Webhook replay window in seconds (accepted clock difference between partner and us).
# WEBHOOK_TIMESTAMP_TOLERANCE_SECONDS=300

# Demo profile only: the plaintext HMAC secret given to the seeded partner `acme-bank`, used by the
# partner simulator and the docs' examples. Change it for any shared demo environment.
# DEMO_PARTNER_SECRET=acme-demo-secret-change-me

# Optional AI assistance via Groq (docs/ai-features.md). Off unless BOTH are set.
# Ticket text is PII-redacted before sending, but ask your lead before enabling (question R10).
AI_ENABLED=false
GROQ_API_KEY=
# GROQ_BASE_URL=https://api.groq.com/openai/v1
# Check https://console.groq.com/docs/models for current production models.
# GROQ_MODEL=openai/gpt-oss-20b

# (Bonus) Redis for dashboard cache + distributed rate limiting (`--profile redis`).
# REDIS_ENABLED=false
