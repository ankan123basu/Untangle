# =============================================================================
# Untangle environment variables
# -----------------------------------------------------------------------------
# Copy to .env (`make up` does this for you on a fresh clone) and change values.
# .env is git-ignored. NEVER commit real secrets.
# Variables marked "(Phase N)" are not read yet; they are listed now so the
# full configuration surface is visible from day one.
# =============================================================================

# ---- Ports published on your machine ----------------------------------------
# Postgres in Docker. 5433 avoids clashing with a local Postgres on 5432.
POSTGRES_HOST_PORT=5433
BACKEND_HOST_PORT=8080
# The app in Docker: open http://localhost:3000
FRONTEND_HOST_PORT=3000
REDIS_HOST_PORT=6379

# ---- Database ---------------------------------------------------------------
POSTGRES_DB=untangle
POSTGRES_USER=untangle
# Local-only default. Use a long random value anywhere else.
POSTGRES_PASSWORD=untangle-local-dev-only

# ---- Backend ----------------------------------------------------------------
# Spring profile inside Docker: prod (secure defaults) | dev (verbose, dev seed data from Phase 1)
SPRING_PROFILES_ACTIVE=prod

# (Phase 2) HMAC key for signing access tokens. Min 32 bytes, base64.
#   Generate: openssl rand -base64 48
# JWT_SECRET=

# (Phase 2) First admin, created on startup if no admin exists (A12).
# BOOTSTRAP_ADMIN_EMAIL=admin@untangle.local
# BOOTSTRAP_ADMIN_PASSWORD=

# (Phase 2) Refresh cookie `Secure` flag. Keep true; set false only for plain-HTTP dev in Safari.
# AUTH_COOKIE_SECURE=true

# (Phase 2) Allowed browser origin for CORS (only needed when not going through nginx/Vite proxy).
# CORS_ALLOWED_ORIGINS=http://localhost:5173

# (Phase 4) AES-256-GCM master key that encrypts partner HMAC secrets at rest. 32 bytes, base64.
#   Generate: openssl rand -base64 32
#   The backend refuses to start without it once Phase 4 lands.
# APP_SECRET_ENCRYPTION_KEY=

# (Phase 4) Webhook replay window in seconds.
# WEBHOOK_TIMESTAMP_TOLERANCE_SECONDS=300

# (Phase 6) Groq AI. Leave GROQ_API_KEY empty to run with AI features hidden.
# AI_ENABLED=false
# GROQ_API_KEY=
# GROQ_BASE_URL=https://api.groq.com/openai/v1
# GROQ_MODEL=

# (Bonus) Redis for dashboard cache + distributed rate limiting (`--profile redis`).
# REDIS_ENABLED=false
